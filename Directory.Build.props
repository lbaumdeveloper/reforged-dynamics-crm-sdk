<Project>
  <PropertyGroup>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>lbaumdeveloper</Authors>
    <RepositoryUrl>https://github.com/lbaumdeveloper/reforged-dynamics-crm-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/lbaumdeveloper/reforged-dynamics-crm-sdk</PackageProjectUrl>
  </PropertyGroup>
</Project>
